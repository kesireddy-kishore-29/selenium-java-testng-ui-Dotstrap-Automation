<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The pull-request gate: the three journeys that must never break. -->
<suite name="smoke" parallel="methods" thread-count="3" data-provider-thread-count="2">
  <test name="smoke">
    <groups>
      <run>
        <include name="smoke"/>
        <exclude name="live"/>
        <exclude name="demo-failure"/>
        <exclude name="quarantine"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.selenium.tests.sauce"/>
      <package name="com.qaautomation.selenium.tests.app"/>
    </packages>
  </test>
</suite>
