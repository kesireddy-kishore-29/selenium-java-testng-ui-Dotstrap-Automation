<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests that fail on purpose, to show the evidence a failure leaves. This suite is expected to
     fail; it is never part of a gating run. -->
<suite name="demo-failure" parallel="methods" thread-count="3">
  <test name="demo-failure">
    <groups>
      <run>
        <include name="demo-failure"/>
      </run>
    </groups>
    <packages>
      <package name="com.qaautomation.selenium.tests.demo"/>
    </packages>
  </test>
</suite>
