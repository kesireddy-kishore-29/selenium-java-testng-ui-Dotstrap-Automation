<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The framework's own unit tests: no browser, no network. They sit next to the code they test. -->
<suite name="unit" parallel="none">
  <test name="unit">
    <packages>
      <package name="com.qaautomation.selenium.config"/>
      <package name="com.qaautomation.selenium.core"/>
      <package name="com.qaautomation.selenium.evidence"/>
      <package name="com.qaautomation.selenium.listeners"/>
      <package name="com.qaautomation.selenium.pages"/>
    </packages>
  </test>
</suite>
