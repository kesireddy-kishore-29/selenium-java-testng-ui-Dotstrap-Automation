<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Every Sauce Demo test and the hybrid sut-ui test. Never the live site, the deliberate failures
     or quarantined tests (they have their own suites). One browser per test, three at a time. -->
<suite name="regression" parallel="methods" thread-count="3" data-provider-thread-count="2">
  <test name="regression">
    <groups>
      <run>
        <exclude name="live"/>
        <exclude name="demo-failure"/>
        <exclude name="quarantine"/>
      </run>
    </groups>
    <packages>
      <package name="com.kishore.qa.selenium.tests.sauce"/>
      <package name="com.kishore.qa.selenium.tests.app"/>
    </packages>
  </test>
</suite>
