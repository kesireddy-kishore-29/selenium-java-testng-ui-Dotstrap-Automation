<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quarantined tests (group "quarantine", each with an owner and an expiry in quarantine.json).
     They still run, in their own non-gating job, so a fix is noticed. Empty today. -->
<suite name="quarantine" parallel="methods" thread-count="2">
  <test name="quarantine">
    <groups>
      <run>
        <include name="quarantine"/>
      </run>
    </groups>
    <packages>
      <package name="com.kishore.qa.selenium.tests.sauce"/>
      <package name="com.kishore.qa.selenium.tests.app"/>
    </packages>
  </test>
</suite>
