<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Formatting is owned by Spotless (google-java-format). Checkstyle owns the rules a formatter
  cannot see: hard waits, swallowed exceptions, order-dependent tests, disabled tests and
  mutable static state. Every rule here maps to a line in docs/test-strategy.md.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
    <property name="optional" value="false"/>
  </module>

  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf"/>
  </module>
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^package.*|^import.*|https?://"/>
  </module>

  <!-- No hard waits anywhere a test can reach. Use Awaitility or an explicit condition. -->
  <module name="RegexpSingleline">
    <property name="id" value="noHardWait"/>
    <property name="format" value="Thread\.sleep\s*\(|TimeUnit\.\w+\.sleep\s*\("/>
    <property name="message" value="Hard wait. Use WaitHelper (an explicit condition)."/>
  </module>
  <!-- Explicit waits only: an implicit wait mixed with explicit waits makes every timeout unpredictable. -->
  <module name="RegexpSingleline">
    <property name="id" value="noImplicitWait"/>
    <property name="format" value="implicitlyWait\s*\("/>
    <property name="message" value="Implicit wait. Use WaitHelper (explicit waits only); see docs/adr."/>
  </module>
  <!-- No test-order dependence: data is created per test, never by an earlier test. -->
  <module name="RegexpSingleline">
    <property name="id" value="noDependsOnMethods"/>
    <property name="format" value="dependsOnMethods|dependsOnGroups"/>
    <property name="message" value="Order-dependent test. Create the data this test needs with a fixture."/>
  </module>
  <!-- No silently disabled tests: quarantine them (group + quarantine.json) so they still run. -->
  <module name="RegexpSingleline">
    <property name="id" value="noDisabledTests"/>
    <property name="format" value="enabled\s*=\s*false|@Ignore\b"/>
    <property name="message" value="Disabled test. Use the quarantine group with an owner and expiry instead."/>
  </module>
  <!-- No console output: everything goes through the logger so it reaches the report. -->
  <module name="RegexpSingleline">
    <property name="id" value="noSystemOut"/>
    <property name="format" value="System\.(out|err)\.print"/>
    <property name="message" value="Use the logger (SLF4J) so output reaches the report."/>
  </module>

  <module name="TreeWalker">
    <!-- No shared mutable state between tests: a static field must be final. -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="noMutableStatic"/>
      <property name="format" value="^\s*(?:(?:private|protected|public)\s+)?static\s+(?!final\b|class\b|record\b|enum\b|interface\b|abstract\b|\{|void\b|synchronized\b|&lt;)[^({=;]*\s\w+\s*(?:=.*)?;\s*$"/>
      <property name="message" value="Mutable static field. Use a final field, a per-test context or a ThreadLocal held in a final field."/>
      <property name="ignoreComments" value="true"/>
    </module>

    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
      <property name="tokens" value="LITERAL_CATCH, LITERAL_FINALLY"/>
    </module>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="Throwable, java.lang.Throwable, Error, java.lang.Error"/>
    </module>
    <module name="AvoidStarImport"/>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, junit.framework, org.junit"/>
    </module>
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="ModifierOrder"/>
    <module name="FinalClass"/>
    <module name="NeedBraces"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="StringLiteralEquality"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
  </module>
</module>
